---
import { FiExternalLink, FiGithub, FiLinkedin } from "react-icons/fi";
import { MdOutlineMail } from "react-icons/md";
---

<footer class="flex flex-1 w-full justify-center items-center bg-primary pt-xl">
	<div
		class="flex max-w-screen-xl w-full flex-col sm:flex-row items-center gap-sm justify-between px-md py-md text-white"
	>
		<ul id="contact" class="flex pb-xl sm:hidden space-x-xl text-md sm:text-xl">
			<li>
				<a
					href="https://github.com/eloy98g"
					class="hover:underline"
					target="_blank"><FiGithub size={32} /></a
				>
			</li>
			<li>
				<a
					href="https://www.linkedin.com/in/eloy-gomez-garcia-464125201/"
					target="_blank"
					class="hover:underline"><FiLinkedin size={32} /></a
				>
			</li>
			<li>
				<a
					href="mailto:eloygomez.contact@gmail.com"
					class="hover:underline"
					target="_blank"><MdOutlineMail size={32} /></a
				>
			</li>
		</ul>

		<a
			href=" https://github.com/eloy98g/Portfolio"
			class="hover:underline"
			target="_blank"
		>
			<strong class="flex flew-row gap-sm text-lg items-center">
				<FiExternalLink size={24} />
				This page is Open source!
			</strong>
		</a>
		<a href="https://astro.build/" class="hover:underline" target="_blank">
			<strong class="flex flew-row gap-sm text-lg items-center">
				🚀 Made With Astro
			</strong>
		</a>
	</div>
</footer>
