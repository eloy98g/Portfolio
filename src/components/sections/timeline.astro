---
import { getCollection } from "astro:content";

const timeline = await getCollection("timeline");
---

<section id="timeline" class="flex flex-col items-center justify-center gap-xl">
	<h1 class="text-4xl font-extrabold">🏄‍♂️ Timeline</h1>
	<div
		class="rounded-2xl bg-secondary p-md flex flex-col item-center justify-center gap-md font-thin w-full"
	>
		{
			timeline
				.sort((a, b) => b.data.gid - a.data.gid)
				.map((item, index) => {
					const { title, image, highlights, label, subtitle } = item.data;

					return (
						<article
							class:list={[
								"flex-col flex gap-md pb-sm",
								{
									" border-b-[1px] border-light-grey":
										index !== timeline.length - 1,
								},
							]}
						>
							<div class="flex flew-row items-center">
								<img
									transition:name={`img-${title}`}
									class="mr-5 size-16 rounded-full"
									src={`/${image}`}
									alt={title}
								/>
								<div class="flex flex-col flex-1 items-left]">
									<h1 class="text-xl sm:text-4xl font-extrabold">{title}</h1>
									<h3 class="text-lg sm:text-lg font-thin sm:font-bold">
										{subtitle}
									</h3>
									<h3 class="sm:hidden block text-xs font-thin">{label}</h3>
								</div>
								<div class="hidden sm:flex items-center justify-center border-2 border-grey rounded-full py-xs px-sm">
									<h3 class="text-lg font-bold">{label}</h3>
								</div>
							</div>

							<div class="flex flex-col gap-xs">
								{highlights.map((highlight) => {
									return (
										<p class="text-md sm:text-xl font-thin">➤ {highlight}</p>
									);
								})}
							</div>
						</article>
					);
				})
		}
	</div>
</section>
