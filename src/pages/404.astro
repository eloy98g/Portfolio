---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada - 404">
	<main class="flex-1 flex items-center justify-center flex-col gap-8 p-8">
		<div class="text-center flex flex-1 flex-col items-center justify-center">
			<h1 class="text-9xl font-bold text-gray-300 mb-4">404 Page not found</h1>
			<div class="flex flex-col gap-xl justify-center items-center">
				<a
					href="/"
					class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition-colors"
				>
					Volver al inicio
				</a>
				<button
					onclick="history.back()"
					class="border border-gray-600 hover:border-gray-500 text-gray-300 px-6 py-3 rounded-lg transition-colors"
				>
					Volver atrás
				</button>
			</div>
		</div>
	</main>
</Layout>
